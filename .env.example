# Copy this file to .env and fill in your credentials (never commit .env to Git)

# Discord
DISCORD_BOT_TOKEN=

# Inference Service
INFERENCE_SERVICE_URL=http://localhost:8000
INFERENCE_TIMEOUT_SECONDS=2

# Database (use postgresql+psycopg2://... in production/Docker)
DATABASE_URL=postgresql+psycopg2://modbot_user:modbot_password@localhost:5432/modbot_db

# Default moderation thresholds (can be overridden per server via /config)
THRESHOLD_LOW=0.30
THRESHOLD_HIGH=0.90

# Optional Discord Webhook URL for ops alerts
OPS_ALERT_WEBHOOK_URL=
