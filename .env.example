# Sao chép file này thành .env rồi điền giá trị thật, .env không bao giờ commit lên Git
# (biện pháp giảm thiểu mối đe doạ "rò rỉ bot token" ở Chương IV mục V báo cáo)

# Discord
DISCORD_BOT_TOKEN=

# Inference Service
INFERENCE_SERVICE_URL=http://localhost:8000
INFERENCE_TIMEOUT_SECONDS=2

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/toxic_mod_bot

# Ngưỡng phân loại mặc định (có thể override theo từng server trong bảng server)
THRESHOLD_LOW=0.30
THRESHOLD_HIGH=0.90

# Webhook Discord riêng để nhận cảnh báo giám sát (Chương V mục IV)
OPS_ALERT_WEBHOOK_URL=
